# ---- Web / WebSocket (uvicorn is started by systemd/Docker; these are read by the app) ----
# Used by `python -m app.main` and Docker. systemd/Nginx deployments bind 127.0.0.1 via the unit file.
TERMINAL_HOST=0.0.0.0
TERMINAL_PORT=8000
TERMINAL_WS_PATH=/ws/terminal
# Comma-separated list of site origins allowed to open the WebSocket. EMPTY = any origin (dev only!)
ALLOWED_ORIGINS=
# Set true ONLY when running behind your own Nginx (trusts X-Real-IP / X-Forwarded-For)
TRUST_PROXY=false
MAX_WS_SESSIONS=50
WS_MAX_MESSAGE_BYTES=8192

# ---- SSH ----
SSH_HOST=0.0.0.0
SSH_PORT=2222
SSH_HOST_KEY=/opt/portfolio-terminal/host_key
SSH_USERNAME=portfolio
MAX_SSH_SESSIONS=20
MAX_SSH_SESSIONS_PER_IP=5

# ---- Sessions ----
IDLE_TIMEOUT_SECONDS=900
COMMAND_RATE_LIMIT=40/minute

# ---- Contact / anti-spam ----
CONTACT_RATE_LIMIT=3/hour
CONTACT_MAX_MESSAGE_LENGTH=2000
CONTACT_MAX_NAME_LENGTH=100
CONTACT_MAX_EMAIL_LENGTH=254
CONTACT_SESSION_LIMIT=2
CONTACT_TIMEOUT_SECONDS=10
# true = log and pretend to send (local testing, no backend configured)
CONTACT_DRY_RUN=true

# Delivery backend: set a webhook OR SMTP (webhook wins if both are set)
CONTACT_WEBHOOK_URL=
# generic | discord | slack
CONTACT_WEBHOOK_FORMAT=generic
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=

# ---- Misc ----
PORTFOLIO_DATA_PATH=
LOG_LEVEL=INFO
