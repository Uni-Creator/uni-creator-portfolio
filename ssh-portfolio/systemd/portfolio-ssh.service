[Unit]
Description=Restricted SSH Portfolio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio-ssh
EnvironmentFile=/etc/portfolio-ssh.env
ExecStart=/opt/portfolio-ssh/.venv/bin/python -m ssh_terminal.server
Restart=always
RestartSec=3

# Defense in depth
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
MemoryDenyWriteExecute=true
ReadWritePaths=/opt/portfolio-ssh

[Install]
WantedBy=multi-user.target
